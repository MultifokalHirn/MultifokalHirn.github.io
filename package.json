{
	"name": "multifokalhirn.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"app:dev": "npm run dev",
		"app:preview": "npm run preview",
		"app:build": "npm run build",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test": "npm run test:coverage && npm run test:storybook && npm run test:e2e",
		"test:coverage": "vitest run --project=server --project=client --coverage",
		"test:unit": "vitest run --project=server --project=client",
		"test:storybook": "vitest run --project=storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"updates:major:check": "ncu",
		"updates:major": "ncu -u",
		"updates:minor:check": "ncu -t minor",
		"updates:minor": "ncu -u -t minor && npm install"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@storybook/addon-a11y": "^10.3.4",
		"@storybook/addon-docs": "^10.3.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.0.0",
		"@storybook/sveltekit": "^10.3.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.2",
		"@vitest/browser-playwright": "^4.0.0",
		"@vitest/coverage-istanbul": "^4.1.2",
		"@vitest/coverage-v8": "^4.0.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.4",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"mdsvex": "^0.12.6",
		"npm-check-updates": "^20.0.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.3.4",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^8.0.5",
		"vitest": "^4.0.0",
		"vitest-browser-svelte": "^2.0.0"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.4"
	}
}
